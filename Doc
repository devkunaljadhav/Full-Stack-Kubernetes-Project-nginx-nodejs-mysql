        <h1>🚀 Employee Dashboard</h1>

        <p>
            View and manage employee records dynamically
        </p>

        <button onclick="loadEmployees()">
            Load Employees
        </button>

        <div id="status"></div>

        <ul id="employees"></ul>

    </div>

<script>

async function loadEmployees() {

    const status =
        document.getElementById('status');

    const list =
        document.getElementById('employees');

    status.innerHTML =
        '<div class="loading">⏳ Loading employees...</div>';

    list.innerHTML = '';

    try {

        const response =
            await fetch('/api/employees');

        if(!response.ok){
            throw new Error(
                'Failed to fetch employees'
            );
        }

        const data =
            await response.json();

        status.innerHTML = '';

        if(data.length === 0){

            status.innerHTML =
                '<div class="loading">No employees found</div>';

            return;
        }

        data.forEach(emp => {

            const li =
                document.createElement('li');

            li.innerText =
                emp.name;

            list.appendChild(li);
        });

    } catch(error){

        console.log(error);

        status.innerHTML =
            '<div class="error">❌ Unable to load employees</div>';
    }
}

</script>

</body>
</html>


