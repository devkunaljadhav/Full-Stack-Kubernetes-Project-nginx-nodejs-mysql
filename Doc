  name: frontend
  namespace: production

spec:
  replicas: 2

  selector:
    matchLabels:
      app: frontend

  template:
    metadata:
      labels:
        app: frontend

    spec:
      containers:
      - name: frontend

        image: trainerreyaz/frontend:v1

        ports:
        - containerPort: 80

kubectl apply -f frontend-deployment.yml

FRONTEND SERVICE
---------------

vi frontend-service.yml

apiVersion: v1
kind: Service

metadata:
  name: frontend-service
  namespace: production

spec:
  selector:
    app: frontend

  ports:
  - port: 80
    targetPort: 80

kubectl create -f frontend-service.yml


STEP 11 — INSTALL INGRESS CONTROLLER
---------------------------------
kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/cloud/deploy.yaml

kubectl get pods -n ingress-nginx

STEP 12 — CREATE INGRESS
-----------------------
vi ingress.yml

apiVersion: networking.k8s.io/v1
kind: Ingress

metadata:
  name: app-ingress
  namespace: production

spec:
  ingressClassName: nginx

  rules:
  - http:
      paths:

      - path: /
        pathType: Prefix
        backend:
          service:
            name: frontend-service
            port:
              number: 80

      - path: /api
        pathType: Prefix
        backend:
          service:
            name: backend-service
            port:
              number: 80

kubectl apply -f ingress.yml

STEP 13 — ACCESS APPLICATION
---------------------------
kubectl get svc -n ingress-nginx

kubectl get pods -n production
	


